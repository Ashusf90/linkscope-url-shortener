{
  "name": "linkscope-url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack URL shortener with click analytics",
  "scripts": {
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/src/**/*.js\" \"server/tests/**/*.js\" \"**/*.json\" \"**/*.md\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"server/src/**/*.js\" \"server/tests/**/*.js\" \"**/*.json\" \"**/*.md\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
